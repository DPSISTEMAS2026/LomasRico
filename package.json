{
    "name": "lo-mas-rico-v2",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently -n web,api,panels -c cyan,green,magenta \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:panels\"",
        "dev:api": "npm run dev -w apps/api",
        "dev:web": "npm run dev -w apps/web -- --port 3000",
        "dev:panels": "npm run dev -w apps/panels -- --port 3002",
        "build": "npm run build --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "db:up": "node scripts/local-db.mjs",
        "db:push": "npx prisma db push --schema=packages/database/prisma/schema.prisma",
        "db:stop": "docker-compose -f infra/local/docker-compose.yml stop",
        "studio": "npx prisma studio --schema=packages/database/prisma/schema.prisma"
    },
    "devDependencies": {
        "@embedded-postgres/windows-x64": "^18.4.0-beta.17",
        "@types/bcryptjs": "^2.4.6",
        "concurrently": "^8.2.2",
        "embedded-postgres": "^18.4.0-beta.17",
        "eslint": "^8.56.0",
        "prettier": "^3.2.4",
        "typescript": "^5.3.3"
    },
    "dependencies": {
        "ajv": "^8.18.0",
        "bcryptjs": "^3.0.3",
        "next": "15.1.0",
        "xlsx": "^0.18.5"
    }
}
