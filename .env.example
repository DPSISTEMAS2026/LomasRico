# Entorno local — 3 piezas: API + web + paneles
# Copiar a: .env  |  apps/api/.env  |  packages/database/.env
# En web y paneles: NEXT_PUBLIC_API_URL en .env.local

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lomasricodb?schema=public"
JWT_SECRET="dev-local-lomasrico"
PORT=3001
NODE_ENV=development
UBER_EATS_ENABLED=false
INVENTORY_ENFORCEMENT=false
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_COMING_SOON="false"
# Pedidos web abiertos por defecto; cerrar con WEB_ORDERS_ENABLED=false
WEB_ORDERS_ENABLED=true
# Horario Chile (default Lun–Mié 14:30-21:00 · Jue–Dom 11:30-22:00)
# WEB_HOURS_SCHEDULE="1,2,3:14:30-21:00;0,4,5,6:11:30-22:00"

# Brevo — correo a clientes (canje de puntos se anuncia, no se habilita aún)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Lo Más Rico"
BREVO_LIST_NAME="LomasRico Clientes"
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_KEY=""
